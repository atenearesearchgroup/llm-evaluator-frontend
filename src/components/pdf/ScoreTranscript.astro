---
import type { AllMessage } from '@/model/chat'
import { ScoreRepresentation } from '../execution/ScoreRepresentation';


export type Props = {
    message: AllMessage;
}

const { message } = Astro.props;

if (message.type === "user") return;



---

<div class="inline-flex items-center rounded-full border 
px-2.5 py-0.5
 text-xs font-semibold transition-colors 
focus:outline-none focus:ring-2 focus:ring-ring focus:ring-offset-2
border-transparent bg-yellow-300 text-primary hover:bg-yellow-300/60 gap-1">
    <ScoreRepresentation score={message.score}/>
</div>
